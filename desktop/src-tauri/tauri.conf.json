{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt Companion Preview",
  "version": "0.2.0",
  "identifier": "com.owenmcgirr.prompt-companion.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prompt Companion Preview",
        "width": 640,
        "height": 900,
        "minWidth": 520,
        "minHeight": 760
      }
    ],
    "security": {
      "capabilities": ["composer"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
